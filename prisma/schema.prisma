// Mô hình dữ liệu của Skipli Food Menu.
// Sửa file này rồi chạy: npm run db:migrate -- --name <ten-thay-doi>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Tài khoản và đăng nhập ─────────────────────────

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  sessions    Session[]
  restaurants Restaurant[]
}

// Link đăng nhập gửi qua email. Chỉ lưu mã băm, không lưu mã gốc.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Phiên đăng nhập. Cookie giữ mã gốc, database chỉ giữ mã băm.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────── Quán ─────────────────────────────

enum Plan {
  FREE
  PRO
}

// Kiểu trang menu khách thấy. Thêm template mới: thêm giá trị ở đây + một giao diện trong src/components/public-menu/styles/.
enum MenuStyle {
  PHOTO // có ảnh, thẻ món hiện đại (giống 1FoodMenu)
  CLASSIC // kiểu chữ như menu giấy: tên món ..... giá
  BOLD // chữ to đậm, giá trong ô màu (quán taco, food truck, burger)
  GRID // lưới ảnh 2 cột kiểu Instagram (cafe, tiệm bánh)
  DARK // nền tối, chữ có chân (pizza buổi tối, bar, nhà hàng sang)
  SIMPLE // chữ đen trên nền trắng, cỡ lớn, không ảnh (quán lâu năm, khách lớn tuổi)
}

enum ContactButton {
  NONE
  CUSTOM_LINK
  PHONE
  WHATSAPP
  EMAIL
  DIRECTIONS
}

model Restaurant {
  id          String  @id @default(cuid())
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug        String  @unique // phần sau /@ trong link
  // Mã menu (dạng 571d...-....) dán vào Skipli Now để lấy dữ liệu món qua /api/menus/<mã>. Giữ nguyên khi sửa menu.
  menuCode    String  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  tagline     String?
  description String? // cho phép định dạng đơn giản (đậm, nghiêng, danh sách)
  country     String  @default("US")
  currency    String  @default("USD")

  // Ảnh (để trống khi chưa có kho ảnh)
  logoUrl     String?
  coverUrl    String?
  galleryUrls String[] @default([]) // tối đa 6 ảnh giới thiệu quán

  accentColor String    @default("#1f4fae")
  menuStyle   MenuStyle @default(PHOTO)

  // Địa chỉ
  addressLine   String?
  city          String?
  region        String? // bang
  postalCode    String?
  googleMapsUrl String?
  addressNote   String? // ví dụ "Cửa vào ở đường Court, đỗ xe sau 6 giờ tối"

  // Giờ mở cửa: mảng 7 phần tử (0 = Chủ nhật … 6 = Thứ bảy), mỗi phần tử
  // { closed: boolean, from: "HH:MM", until: "HH:MM" }. Để trống = chưa nhập giờ.
  openingHours Json?
  // Múi giờ của quán: thống kê theo ngày/giờ tính theo giờ địa phương của quán
  timeZone     String  @default("America/New_York")

  // Nút liên hệ: để trống nghĩa là tắt
  customLinkLabel String?
  customLinkUrl   String?
  phone           String?
  whatsapp        String?
  contactEmail    String?
  showDirections  Boolean       @default(false)
  primaryButton   ContactButton @default(NONE)
  secondaryButton ContactButton @default(NONE)

  // SEO
  seoTitle       String?
  seoDescription String?
  inSitemap      Boolean @default(false)

  isPublished Boolean @default(false) // trang tắt thì link và QR báo "chưa mở"
  plan        Plan    @default(FREE) // gắn Stripe ở phase sau

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categories Category[]
  items      MenuItem[]
  extras     Extra[]
  allergens  Allergen[]
  pageViews  PageView[]
  itemClicks ItemClick[]
  menuReads  AiMenuRead[]

  @@index([ownerId])
}

// ───────────────────────────── Menu ─────────────────────────────

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  position     Int        @default(0)
  isVisible    Boolean    @default(true)

  // Giờ phục vụ. Ngày trống = luôn phục vụ. Ngày: 0 = Chủ nhật … 6 = Thứ bảy.
  // Giờ dạng "HH:MM". Trang khách vẫn hiện danh mục, chỉ ghi giờ bên cạnh.
  servingDays  Int[]   @default([])
  servingFrom  String?
  servingUntil String?

  items MenuItem[]

  @@index([restaurantId, position])
}

enum DietaryTag {
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  HALAL
  SPICY
}

model MenuItem {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceCents   Int?         // để trống = không ghi giá (ví dụ "giá theo mùa")
  imageUrl     String?
  position     Int          @default(0)
  isVisible    Boolean      @default(true)
  isSoldOut    Boolean      @default(false)
  isFeatured   Boolean      @default(false) // "Chef's pick": hiện ở đầu trang
  dietaryTags  DietaryTag[] @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  extras    MenuItemExtra[]
  allergens MenuItemAllergen[]
  clicks    ItemClick[]
  // Giá theo cỡ (Small/Large, Glass/Bottle…). Có cỡ thì priceCents = giá thấp nhất (để sắp xếp, "from $x").
  variants  ItemVariant[]

  @@index([restaurantId])
  @@index([categoryId, position])
}

// Món thêm có giá (thêm phô mai, thêm sốt...)
/// Một cỡ / lựa chọn của món, có giá riêng. Tối đa 6 cỡ mỗi món.
model ItemVariant {
  id         String   @id @default(cuid())
  itemId     String
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int
  position   Int      @default(0)

  @@index([itemId, position])
}

model Extra {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  priceCents   Int             @default(0)
  position     Int             @default(0)
  items        MenuItemExtra[]

  @@index([restaurantId, position])
}

model MenuItemExtra {
  itemId  String
  item    MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  extraId String
  extra   Extra    @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@id([itemId, extraId])
}

// Chất gây dị ứng. Mã A, B, C… tính theo thứ tự (position), kéo để đổi thứ tự.
model Allergen {
  id           String             @id @default(cuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  position     Int                @default(0)
  items        MenuItemAllergen[]

  @@index([restaurantId, position])
}

model MenuItemAllergen {
  itemId     String
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([itemId, allergenId])
}

// ── Thống kê (Phase 4) ─────────────────────────────────
// Không lưu IP. "visitorHash" = mã băm của (muối trong ngày + quán + IP + trình duyệt).
// Muối đổi mỗi ngày và bị xóa sau 2 ngày, nên không thể nối một người qua nhiều ngày,
// chỉ đếm được "bao nhiêu khách khác nhau trong ngày".

enum TrafficSource {
  QR
  DIRECT // gõ link, tin nhắn (WhatsApp, iMessage…), app không gửi nguồn
  INSTAGRAM
  FACEBOOK
  GOOGLE
  OTHER // trang web khác (ghi tên miền ở referrerHost)
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
}

model PageView {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  visitorHash  String
  source       TrafficSource
  referrerHost String?
  device       DeviceType
  // Vị trí: chỉ cấp thành phố / bang / quốc gia (lấy từ máy chủ hosting, không tự định vị)
  city         String?
  region       String?
  country      String?
  // Tọa độ gần đúng của thành phố (theo nhà mạng, không phải GPS), làm tròn 1 chữ số thập phân (~10 km)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime      @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, visitorHash, createdAt])
}

model ItemClick {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  itemId       String
  item         MenuItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  visitorHash  String
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
  @@index([itemId, visitorHash, createdAt])
  @@index([restaurantId, visitorHash, createdAt])
}

/// Muối của từng ngày (giờ UTC) để băm mã khách. Xóa sau 2 ngày.
model DailySalt {
  day       String   @id // "2026-11-19"
  salt      String
  createdAt DateTime @default(now())
}

/// Mỗi lần dùng AI đọc ảnh menu (để giới hạn số lần mỗi ngày: key AI dùng chung hạn mức với Skipli Content).
model AiMenuRead {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ok           Boolean
  engine       String? // "gemini" | "groq"
  dishes       Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

# Chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# Kết nối database. Giá trị dưới đây khớp với docker-compose.yml (chỉ dùng trên máy).
# Khi đưa lên mạng (ví dụ Neon), thay bằng link kết nối của database thật.
DATABASE_URL="postgresql://skipli:skipli_local_dev@localhost:5433/skipli_food_menu?schema=public"

# Địa chỉ gốc của trang web (dùng để tạo link menu và mã QR).
NEXT_PUBLIC_APP_URL="http://localhost:3300"

# Chuỗi bí mật ngẫu nhiên, dùng để băm (không lưu IP thô) và ký phiên đăng nhập.
# Tạo bằng lệnh: openssl rand -base64 32
APP_SECRET=""

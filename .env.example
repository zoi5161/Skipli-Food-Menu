# Chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.
# Khi đưa lên Vercel: điền các biến này trong Vercel → Project → Settings → Environment Variables.
# Hướng dẫn từng bước: docs/trien-khai.md

# ── Database ─────────────────────────────────────────
# Trên máy: khớp với docker-compose.yml.
# Trên Neon: DATABASE_URL = link "Pooled connection" (có chữ -pooler), DIRECT_URL = link "Direct connection".
DATABASE_URL="postgresql://skipli:skipli_local_dev@localhost:5433/skipli_food_menu?schema=public"
DIRECT_URL=""

# ── Địa chỉ trang web ────────────────────────────────
# Dùng để tạo link menu, mã QR, link đăng nhập. Ví dụ khi lên mạng: https://skipli-menu.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3300"

# ── Email đăng nhập (Resend) ─────────────────────────
# Để trống khi chạy trên máy (link đăng nhập hiện ngay trên màn hình).
RESEND_API_KEY=""
# Người gửi. Phải là tên miền đã xác minh trong Resend, ví dụ: Skipli Menu <login@ten-mien.com>
EMAIL_FROM=""

# ── Kho ảnh chuẩn S3 (Cloudflare R2 đề xuất; Backblaze B2, Amazon S3 cũng được) ──
# Để trống khi chạy trên máy (ảnh lưu trong thư mục storage/). Trên Vercel BẮT BUỘC điền.
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Địa chỉ công khai của bucket (tên miền riêng nối với bucket), ví dụ https://images.skiplimenu.com
S3_PUBLIC_URL=""

# ── Dọn dữ liệu hằng ngày (Vercel Cron) ──────────────
# Chuỗi ngẫu nhiên. Tạo bằng lệnh: openssl rand -hex 32
CRON_SECRET=""

# ── Bản trên máy dùng chung database với bản trên mạng (tuỳ chọn) ──
# Khóa để bản trên máy báo bản trên mạng xóa lưu đệm menu sau mỗi lần lưu. Điền CÙNG giá trị ở cả 2 nơi
# (.env trên máy và Vercel). Tạo bằng lệnh: openssl rand -hex 32. Để trống thì /api/revalidate luôn từ chối.
REVALIDATE_SECRET=
# CHỈ điền trên máy (không điền trên Vercel): link bản trên mạng, ví dụ https://skipli-menu.vercel.app
# Có giá trị này thì link menu và mã QR ở trang quản lý trên máy trỏ về bản trên mạng.
REMOTE_APP_URL=
# Chuyển qua lại: npm run env:shared / npm run env:local (xem docs/trien-khai.md)

# ── Khác ─────────────────────────────────────────────
# Chuỗi bí mật ngẫu nhiên dự phòng (hiện chưa dùng). Tạo bằng lệnh: openssl rand -base64 32
APP_SECRET=""

# ── AI dùng chung với Skipli Content ─────────────────
# Chép giá trị từ skipli-content-skills/deploy/.env (tự mở file và copy, không dán vào chat).
# Trên Vercel: Settings → Environment Variables.

# Đọc ảnh menu (bắt buộc ít nhất 1 trong 2)
GEMINI_API_KEY=""
GROQ_API_KEY=""
# Tuỳ chọn, để trống là dùng mặc định
GEMINI_IMAGE_MODELS=""
GROQ_VISION_MODEL=""

# GoClaw (chỉ khi cần chạy agent; hiện GoClaw chỉ có trong mạng nội bộ server công ty, Vercel chưa gọi được)
GOCLAW_URL=""
GOCLAW_GATEWAY_TOKEN=""
GOCLAW_USER_ID="system"
